/*
================================================================================
MIRA-NF low-memory Nextflow config for machines with <= 3 GB RAM
================================================================================
Important:
- This config limits Nextflow scheduling to one local task at a time.
- It caps requested process memory below 3 GB.
- It disables automatic retry escalation, because retrying with more memory is
  not useful on a 3 GB machine.
- It cannot make an individual tool succeed if that tool genuinely needs more
  than the available RAM.
- Keep input datasets small for teaching purposes.
================================================================================
*/

params {
    // Resource caps used by this low-memory profile
    max_cpus   = 1
    max_memory = '2500 MB'
    max_time   = '72 h'

    // Keep optional extra analyses off by default on very small machines.
    // Command-line parameters can still override these if needed.
    read_qc       = false
    nextclade     = false
    parquet_files = false

    // Optional: uncomment this for very small teaching/demo runs.
    // The exact value should be chosen according to the tutorial dataset.
    // subsample_reads = 50000
}

profiles {

    lowmem3gb {

        // Local executor limits.
        // queueSize=1 and maxForks=1 prevent concurrent MIRA-NF tasks from
        // competing for the same small RAM pool.
        executor {
            name      = 'local'
            cpus      = 1
            memory    = '2800 MB'
            queueSize = 1
        }

        process {
            executor = 'local'

            // Conservative defaults for every process.
            cpus   = 1
            memory = '2200 MB'
            time   = '12 h'

            // Run only one process at a time.
            maxForks = 1

            // Do not retry with larger resources on a 3 GB machine.
            maxRetries = 0
            maxErrors  = 1
            errorStrategy = 'terminate'

            // Avoid scratch staging on small local/WSL systems.
            scratch = false

            // Override MIRA-NF resource labels.
            // The upstream local profile uses larger values for these labels,
            // so we force all labels back under the 3 GB machine limit.
            withLabel: process_single {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withLabel: process_low {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withLabel: process_medium {
                cpus   = 1
                memory = '2200 MB'
                time   = '16 h'
                maxForks = 1
            }

            withLabel: process_high {
                cpus   = 1
                memory = '2400 MB'
                time   = '24 h'
                maxForks = 1
            }

            withLabel: process_high_memory {
                cpus   = 1
                memory = '2400 MB'
                time   = '48 h'
                maxForks = 1
            }

            withLabel: process_long {
                cpus   = 1
                memory = '2200 MB'
                time   = '48 h'
                maxForks = 1
            }

            // Module-specific conservative limits for common MIRA-NF steps.
            withName: CONCATFASTQS {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withName: SAMPLESHEET_CHECK {
                cpus   = 1
                memory = '800 MB'
                time   = '1 h'
                maxForks = 1
            }

            withName: NEXTFLOWSAMPLESHEET {
                cpus   = 1
                memory = '800 MB'
                time   = '1 h'
                maxForks = 1
            }

            withName: FINDCHEMISTRY {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withName: FINDCHEMISTRYI {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withName: FINDCHEMISTRYO {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withName: TRIMBARCODES {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: SC2TRIMPRIMERS {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: RSVTRIMPRIMERS {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: FLUTRIMPRIMERS {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: IRMA {
                cpus   = 1
                memory = '2400 MB'
                time   = '24 h'
                maxForks = 1
            }

            withName: CONFIRMIRMAOUTPUT {
                cpus   = 1
                memory = '800 MB'
                time   = '2 h'
                maxForks = 1
            }

            withName: CREATEDAISINPUT {
                cpus   = 1
                memory = '1200 MB'
                time   = '2 h'
                maxForks = 1
            }

            withName: DAISRIBOSOME {
                cpus   = 1
                memory = '2400 MB'
                time   = '24 h'
                maxForks = 1
            }

            withName: PREPAREMIRAREPORTS {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: MULTIQC {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }

            withName: GETNEXTCLADEDATASET {
                cpus   = 1
                memory = '800 MB'
                time   = '2 h'
                maxForks = 1
            }

            withName: RUNNEXTCLADE {
                cpus   = 1
                memory = '1800 MB'
                time   = '8 h'
                maxForks = 1
            }

            withName: UPDATEMIRASUMMARY {
                cpus   = 1
                memory = '1200 MB'
                time   = '4 h'
                maxForks = 1
            }
        }

        // Keep Java-based tools inside tasks from trying to reserve too much RAM.
        // This affects task environments, not the Nextflow launcher JVM itself.
        env {
            JAVA_TOOL_OPTIONS = '-Xmx2200m'
            _JAVA_OPTIONS     = '-Xmx2200m'
        }
    }
}
