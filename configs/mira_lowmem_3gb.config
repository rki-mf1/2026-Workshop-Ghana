/*
================================================================================
MIRA-NF low-memory Nextflow config for machines with <= 3 GB RAM
================================================================================
Important:
- This config limits Nextflow scheduling to one local task at a time.
- It caps requested process memory below 3 GB.
- It disables automatic retry escalation, because retrying with more memory is
  not useful on a 3 GB machine.
- It cannot make an individual tool succeed if that tool genuinely needs more
  than the available RAM.
- Keep input datasets small for teaching purposes.
================================================================================
*/

process {
    // Default resources for all processes
    cpus   = { 1    * task.attempt }
    memory = { 3.GB * task.attempt } // reduced from 6G default
    time   = { 4.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Memory overrides for heavy processes
    withName: 'TRIMBARCODES' {
        memory = '3G'
        cpus   = 1
    }

    withName: 'IRMA' {
        memory = '3G'
        cpus   = 2
    }

    withName: 'DAISRIBOSOME' {
        memory = '3G'
        cpus   = 2
    }

    withName: 'PREPAREMIRAREPORTS' {
        memory = '3G'
        cpus   = 1
    }
}
